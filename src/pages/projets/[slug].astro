---
import type { GetStaticPaths } from 'astro';
import PageProjet from '../../components/pages/PageProjet.astro';
import { projets, slugDe } from '../../utils/projets.ts';

export const getStaticPaths = (async () => {
  const entrees = await projets('fr');
  return entrees.map((entree) => ({
    params: { slug: slugDe(entree) },
    props: { entree },
  }));
}) satisfies GetStaticPaths;

const { entree } = Astro.props;
---

<PageProjet entree={entree} langue="fr" />
