---
import { Icon } from 'astro-icon/components';
import { traductions, type Langue } from '../i18n/index.ts';

interface Props {
  langue: Langue;
  class?: string;
}

const { langue, class: className = '' } = Astro.props;
const t = traductions(langue);
---

{/*
  Trois états, pas deux : « système », « clair », « sombre ». Un simple
  interrupteur binaire enferme le visiteur dans un choix qu'il ne peut plus
  rendre au système. Le bouton affiche l'icône de ce vers quoi il bascule.
*/}
<button
  type="button"
  class={`theme-toggle ${className}`}
  aria-label={t.nav.theme}
  title={t.nav.theme}
  data-theme-toggle
>
  <Icon name="fa6-solid:sun" class="theme-toggle__icon theme-toggle__icon--clair" />
  <Icon name="fa6-solid:moon" class="theme-toggle__icon theme-toggle__icon--sombre" />
</button>

<style lang="scss">
  @use '../styles/texture' as tx;

  @layer astro-components {
    // Un galet en relief, comme les boutons ronds de la référence #2. C'est
    // le contrôle du site qui se prête le mieux à l'effet : petit, rond, sans
    // texte, et fait pour être pressé.
    .theme-toggle {
      display: grid;
      place-items: center;
      width: 2.25rem;
      aspect-ratio: 1;
      flex-shrink: 0;
      padding: 0;
      @include tx.relief($rayon: 50%, $force: 0.8);
      color: var(--text-muted);
      cursor: pointer;
      transition:
        color var(--transition-duration),
        box-shadow var(--transition-duration);

      &:hover {
        color: var(--link-color);
      }

      &:active {
        @include tx.relief-enfonce($force: 0.9);
      }

      .theme-toggle__icon {
        // Les deux icônes occupent la même cellule de grille : aucune
        // recomposition au changement de thème, donc aucun saut de l'en-tête.
        grid-area: 1 / 1;
        width: 0.95rem;
        height: auto;
        transition:
          opacity var(--transition-duration),
          rotate var(--transition-duration);
      }
    }

    // Le site ouvre en sombre : le bouton propose donc le clair, et c'est le
    // soleil qu'on montre. C'est l'état par défaut, celui de `:root` nu.
    .theme-toggle__icon--clair {
      opacity: 1;
      rotate: 0deg;
    }
    .theme-toggle__icon--sombre {
      opacity: 0;
      rotate: 90deg;
    }
  }
</style>

<style is:global lang="scss">
  // Cette règle doit être globale : un style scopé ne peut pas atteindre
  // `:root`, qui porte l'attribut de thème.
  //
  // Il n'y a plus qu'un seul cas à couvrir, et c'est une conséquence directe
  // du choix « sombre par défaut ». Le site ne consulte plus
  // `prefers-color-scheme` : l'état par défaut est le sombre pour tout le
  // monde, et seul un choix explicite du visiteur le fait basculer. Les trois
  // blocs qui vivaient ici (préférence système, choix sombre, choix clair)
  // se réduisent donc à l'unique état qui diffère du défaut.
  @layer astro-components {
    :root[data-theme='light'] .theme-toggle {
      .theme-toggle__icon--clair {
        opacity: 0;
        rotate: -90deg;
      }
      .theme-toggle__icon--sombre {
        opacity: 1;
        rotate: 0deg;
      }
    }
  }
</style>

<script>
  // Délégation sur le document plutôt qu'un écouteur sur le bouton : avec les
  // transitions de vue, le bouton est remplacé à chaque navigation, et un
  // écouteur attaché à l'ancien élément serait perdu en silence.
  document.addEventListener('click', (evenement) => {
    const cible = evenement.target as HTMLElement | null;
    if (!cible?.closest('[data-theme-toggle]')) return;

    const racine = document.documentElement;

    // Sans choix explicite, le site est en sombre, quelle que soit la
    // préférence système, qui n'est plus consultée nulle part. Interroger
    // `matchMedia` ici rendrait le premier clic inopérant sur une machine
    // réglée en clair : le bouton basculerait vers l'état déjà affiché.
    const effectif = racine.dataset.theme === 'light' ? 'light' : 'dark';
    const suivant = effectif === 'dark' ? 'light' : 'dark';

    racine.dataset.theme = suivant;
    try {
      localStorage.setItem('theme', suivant);
    } catch {
      /* stockage bloqué : le choix vaut pour la page courante seulement */
    }
  });
</script>
