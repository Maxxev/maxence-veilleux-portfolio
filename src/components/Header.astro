---
import Container from './Container.astro';
import Logo from './Logo.astro';
import Section from './Section.astro';
import Burger from './Burger.astro';
import ThemeToggle from './ThemeToggle.astro';
import LangSwitcher from './LangSwitcher.astro';

import { traductions, chemin, type Langue } from '../i18n/index.ts';
import { navigationPrincipale } from '../utils/navigation.ts';
import { nom } from '../utils/reglages.ts';

interface Props {
  langue: Langue;
  slugProjet?: string;
}

const { langue, slugProjet } = Astro.props;
const t = traductions(langue);
const liens = navigationPrincipale(t);

// Le lien actif se déduit du chemin, pas d'une propriété passée par chaque
// page : une page qui oublierait de la passer perdrait silencieusement son
// indicateur, et personne ne s'en apercevrait.
const cheminActuel = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;

function estActif(cible: string): boolean {
  if (cible === chemin('accueil', langue)) return cheminActuel === cible;
  return cheminActuel.startsWith(cible);
}

---

<header class="header">
  <Section RootTag="div" class="header__section">
    <Container class="header__container">
      <a class="header__home" href={chemin('accueil', langue)} aria-label={t.nav.retourAccueil}>
        <Logo class="header__logo" />
        <span class="header__nom">{nom}</span>
      </a>

      <nav id="nav-principale" class="header__nav" aria-label={t.nav.menu}>
        <ul>
          {
            liens.map((lien) => (
              <li>
                <a
                  href={chemin(lien.cle, langue)}
                  aria-current={estActif(chemin(lien.cle, langue)) ? 'page' : undefined}
                >
                  {lien.libelle}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="header__actions">
        <ThemeToggle langue={langue} />
        <LangSwitcher langue={langue} slugProjet={slugProjet} />
        <Burger class="header__burger" aria-controls="nav-principale" />
      </div>
    </Container>
  </Section>
</header>

<style lang="scss">
  @use '../styles/breakpoints' as bp;
  @use '../styles/text' as t;

  @layer astro-components {
    .header {
      position: sticky;
      top: 0;
      z-index: 1000;
      // L'en-tête flotte au-dessus des nappes du hero, qui remontent sous lui.
      // C'est l'endroit du site où le verre dépoli est le plus justifié : la
      // barre laisse deviner la couleur qui défile dessous au lieu de la
      // masquer, et le contenu reste lisible parce que le voile est dense.
      //
      // Le voile et son flou sont portés par un PSEUDO-ÉLÉMENT, et non par
      // `.header` elle-même. Ce n'est pas un détour gratuit.
      //
      // Un élément qui porte un `backdrop-filter` devient une « racine
      // d'arrière-plan » : ses descendants ne peuvent plus échantillonner que
      // ce qui est peint à l'intérieur de lui, jamais la page derrière. Le
      // tiroir de navigation mobile est un descendant de `.header` et porte
      // son propre flou. Tant que `.header` était floutée, ce flou s'appliquait
      // au vide, et le contenu de la page restait parfaitement net sous le
      // menu déplié, au point de rendre les liens difficiles à lire.
      //
      // Déplacé sur `::before`, le flou couvre exactement la même surface,
      // mais `.header` cesse d'être une racine d'arrière-plan et le tiroir
      // retrouve la page à flouter.
      background-color: transparent;
      border-bottom: 1px solid var(--glass-border);

      &::before {
        content: '';
        position: absolute;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        background-color: var(--glass-bg-lisible);
        -webkit-backdrop-filter: blur(14px) saturate(var(--glass-saturation));
        backdrop-filter: blur(14px) saturate(var(--glass-saturation));
      }
      transition:
        height 0s var(--transition-duration),
        border-color var(--transition-duration);

      .header__section {
        padding-block: 0;
        background-color: transparent;
      }

      .header__container {
        flex-direction: row;
        align-items: center;
        gap: var(--space-s);
        min-height: var(--header-height);
      }

      .header__home {
        display: flex;
        // `center` et non `baseline` : un SVG n'a pas de ligne de base, et
        // l'alignement sur celle du nom le posait de travers.
        align-items: center;
        gap: 0.7ch;
        margin-right: auto;
        color: var(--heading-color);
        font-family: var(--heading-font-family);
        font-weight: 700;
        letter-spacing: -0.02em;

        &:hover {
          color: var(--link-color);
        }
      }

      .header__logo {
        height: 1.6rem;
      }

      .header__nom {
        font-size: var(--text-0);
        // Le nom complet cède la place aux initiales quand l'espace manque ;
        // les initiales, elles, ne disparaissent jamais.
        display: none;
      }

      .header__actions {
        display: flex;
        align-items: center;
        // Un cran au-dessus de `--space-xxs` : trois contrôles ronds collés
        // se lisaient comme un seul objet segmenté plutôt que comme trois
        // boutons distincts.
        gap: var(--space-xs);
        flex-shrink: 0;
      }

      // --- Navigation, état replié (mobile) ---
      .header__nav {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background-color: var(--glass-bg-lisible);
        -webkit-backdrop-filter: blur(14px) saturate(var(--glass-saturation));
        backdrop-filter: blur(14px) saturate(var(--glass-saturation));
        border-bottom: 1px solid var(--glass-border);
        overflow: clip;
        height: 0;
        // `height: 0` seul laisse les liens focusables au clavier : sans
        // `visibility`, la tabulation part dans un menu invisible.
        visibility: hidden;
        transition:
          height var(--transition-duration),
          visibility var(--transition-duration);

        ul {
          list-style-type: none;
          padding: var(--space-s) var(--section-inline-padding);
          margin-inline: auto;
          width: var(--container-width);
          max-width: 100%;
          display: flex;
          flex-direction: column;
          gap: 1px;
        }

        li a {
          display: block;
          padding-block: 0.7ex;
          color: var(--text-color);
          font-family: var(--heading-font-family);
          font-size: var(--text-1);
          font-weight: 500;

          &:hover,
          &[aria-current='page'] {
            color: var(--link-color);
          }
        }
      }
    }

    @media (min-width: bp.$xs) {
      .header .header__nom {
        display: inline;
      }
    }

    // --- Navigation, état déployé (bureau) ---
    @media (min-width: bp.$md) {
      .header {
        .header__burger {
          display: none;
        }

        .header__nav {
          position: static;
          height: auto;
          visibility: visible;
          overflow: visible;
          background-color: transparent;
          border-bottom: none;
          // Le flou du tiroir mobile doit être annulé explicitement.
          // `background-color: transparent` ne suffit pas : un
          // `backdrop-filter` actif reste visible sans aucun fond, puisqu'il
          // agit sur ce qui est DERRIÈRE l'élément. Il dessinait donc un
          // rectangle flouté et sursaturé autour des liens, qui sautait aux
          // yeux dès que le hero passait une couleur claire dessous.
          -webkit-backdrop-filter: none;
          backdrop-filter: none;

          ul {
            flex-direction: row;
            gap: var(--space-s);
            padding: 0;
            width: auto;
          }

          li a {
            position: relative;
            padding-block: 0;
            font-size: var(--text-0);
            text-wrap: nowrap;

            // Le soulignement pousse depuis la gauche au survol, et reste
            // affiché sur la page courante.
            &::after {
              content: '';
              position: absolute;
              left: 0;
              top: calc(100% + 3px);
              height: 2px;
              width: 0;
              border-radius: 2px;
              background-image: var(--gradient-signature);
              transition: width var(--transition-duration) ease-out;
            }

            &:hover::after,
            &[aria-current='page']::after {
              width: 100%;
            }
          }
        }
      }
    }
  }
</style>

<style is:global lang="scss">
  @layer astro-components {
    :root {
      --header-height: 3.75rem;
    }

    // Le menu déplié : la hauteur passe à `fit-content` quand le burger est
    // ouvert. Cette règle doit être globale : elle traverse la frontière entre
    // Header et Burger, deux composants aux styles scopés séparément.
    .header:has(.burger.is-open) .header__nav {
      height: fit-content;
      visibility: visible;
    }
  }
</style>
