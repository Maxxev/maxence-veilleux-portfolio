---
import Container from './Container.astro';
import Section from './Section.astro';
import ContactLinks from './ContactLinks.astro';
import Signature from './Signature.astro';

import { traductions, chemin, type Langue } from '../i18n/index.ts';
import { navigationPrincipale } from '../utils/navigation.ts';
import { nom, reglages } from '../utils/reglages.ts';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const t = traductions(langue);
const liens = navigationPrincipale(t);
const annee = new Date().getFullYear();
---

<Section RootTag="footer" class="footer">
  <Container class="footer__container">
    {/*
      La signature ferme le document, comme on signe une lettre. C'est la place
      qu'elle a gagnée en quittant le hero : là-haut elle concurrençait le logo
      et le nom en grand, ici elle est la seule marque manuscrite de la page.
    */}
    <div class="footer__brand">
      <Signature langue={langue} class="footer__signature" />
      <p class="footer__nom">{nom}</p>
      <p class="footer__role">{t.accueil.surTitre}</p>
    </div>

    <nav class="footer__nav" aria-label={t.nav.menu}>
      <ul>
        {
          liens.map((lien) => (
            <li>
              <a href={chemin(lien.cle, langue)}>{lien.libelle}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ContactLinks langue={langue} variante="discret" class="footer__contact" />

    <div class="footer__bas">
      <p>&copy; {annee} {nom}. {t.pied.droits}</p>
      <p class="footer__credit">
        {
          reglages.profils.github ? (
            <a
              href={`${reglages.profils.github}/maxence-veilleux-portfolio`}
              target="_blank"
              rel="noopener noreferrer"
            >
              {t.pied.construit}
            </a>
          ) : (
            <span>{t.pied.construit}</span>
          )
        }
      </p>
    </div>
  </Container>
</Section>

<style lang="scss">
  @use '../styles/breakpoints' as bp;
  @use '../styles/texture' as tx;

  @layer astro-components {
    .footer {
      margin-top: auto;
      padding-block: var(--space-l) var(--space-m);
      background-color: var(--surface-sunken);
      position: relative;
      isolation: isolate;

      // Le dégradé du CV en filet de 2 px, à la place d'une bordure grise.
      //
      // C'est le geste le moins coûteux du site et l'un des plus utiles : il
      // referme la page sur la couleur qui l'a ouverte. Un pied de page borné
      // par un trait neutre se lit comme la fin du gabarit ; borné par le
      // dégradé, comme la fin du document.
      border-top: none;

      &::before {
        content: '';
        position: absolute;
        inset: 0 0 auto 0;
        height: 2px;
        background-image: var(--gradient-signature);
      }

      // Une nappe très diluée, pour que le bas de page ne retombe pas dans
      // l'aplat après un site entier en couleur.
      --aurora-force: 0.22;

      &::after {
        content: '';
        position: absolute;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        @include tx.aurora;
      }

      .footer__container {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: var(--space-m);
      }

      .footer__signature {
        // Plus discrète que dans le hero : c'est un paraphe, pas un titre.
        width: min(100%, 9.5rem);
        color: var(--text-muted);
        margin-bottom: var(--space-xs);
      }

      .footer__nom {
        font-family: var(--heading-font-family);
        font-weight: 700;
        font-size: var(--text-1);
        color: var(--heading-color);
        letter-spacing: -0.02em;
      }

      .footer__role {
        color: var(--text-muted);
        font-size: var(--text--1);
      }

      .footer__nav ul {
        list-style-type: none;
        padding-inline-start: 0;
        display: flex;
        flex-direction: column;
        gap: 1ex;

        a {
          width: fit-content;
          color: var(--text-muted);
          font-weight: 400;
          font-size: var(--text--1);

          &:hover {
            color: var(--link-color);
          }
        }
      }

      .footer__bas {
        grid-column: 1 / -1;
        padding-top: var(--space-s);
        border-top: 1px solid var(--border-subtle);
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: var(--space-xs) var(--space-s);
        color: var(--text-muted);
        font-size: var(--text--2);

        a {
          color: inherit;
          font-weight: 400;

          &:hover {
            color: var(--link-color);
          }
        }
      }
    }

    @media (min-width: bp.$sm) {
      .footer .footer__container {
        grid-template-columns: minmax(0, 1.5fr) repeat(2, minmax(0, 1fr));
      }
    }
  }
</style>
