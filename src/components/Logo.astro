---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

{/*
  Le logo « MV », dessiné par Maxence.

  Il est en ligne dans la page plutôt que chargé comme fichier : c'est une
  requête de moins sur chaque page du site, et le SVG est plus court que
  l'en-tête HTTP qui l'accompagnerait.

  Le dégradé est celui du CV, aux valeurs exactes du fichier d'origine —
  #FB642D, #F73B9F, #9849F3. Ce sont les mêmes arrêts que
  `--gradient-signature` dans `_colors.scss`, ce qui n'est pas une
  coïncidence : la palette du site a été échantillonnée sur le même document.
  Ils restent écrits en dur ici, parce qu'un `fill` SVG ne sait pas lire une
  variable CSS portant un dégradé, seulement une couleur simple.

  L'export d'origine contenait trois définitions de dégradé identiques, une par
  tracé. Elles sont fusionnées en une seule.

  `aria-hidden` : le nom complet est écrit juste à côté dans l'en-tête, et le
  lien qui les contient porte déjà son propre libellé. Annoncer le logo en plus
  ferait entendre l'identité trois fois.
*/}
<svg
  class={`logo ${className}`}
  viewBox="0 0 1776 1352"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <radialGradient
      id="logo-mv-degrade"
      cx="0"
      cy="0"
      r="1"
      gradientUnits="userSpaceOnUse"
      gradientTransform="translate(-21.9883 1100.5) rotate(-31.467) scale(2137.9 2033.26)"
    >
      <stop stop-color="#FB642D" />
      <stop offset="0.5" stop-color="#F73B9F" />
      <stop offset="1" stop-color="#9849F3" />
    </radialGradient>
  </defs>

  {/* Le V */}
  <path
    fill-rule="evenodd"
    clip-rule="evenodd"
    d="M968.012 209.268L784.645 234.207V1212.37L1556.42 129.242L1324.21 160.824L968.012 659.5V209.268Z"
    fill="url(#logo-mv-degrade)"
  />
  {/* Le M */}
  <path
    fill-rule="evenodd"
    clip-rule="evenodd"
    d="M536.512 1156.95L704.989 1211.61V245.041L531.258 268.669L401.512 544.5L268.26 304.438L100.012 327.32V1015.31L258.025 1066.59V594.743L401.512 859L536.512 582.5V1156.95Z"
    fill="url(#logo-mv-degrade)"
  />
  {/* Le cadre en perspective */}
  <path
    fill-rule="evenodd"
    clip-rule="evenodd"
    d="M0.0117188 240L0 1088.52L808.692 1351.28L1775.01 0L0.0117188 240ZM50.0117 283.5L1664.22 64.1201L868.236 1181.22L789.035 1290.78L51.465 1051.13L50.0117 283.5Z"
    fill="url(#logo-mv-degrade)"
  />
</svg>

<style lang="scss">
  @layer astro-components {
    .logo {
      // La hauteur pilote, la largeur suit : le rapport du dessin est de
      // 1776/1352, et le fixer en dur ici obligerait à le corriger à chaque
      // changement de taille.
      height: 1.75rem;
      width: auto;
      display: block;
      flex-shrink: 0;
    }
  }
</style>
