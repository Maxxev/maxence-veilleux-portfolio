---
const { class: className = '', ...rest } = Astro.props;
---

<button
  type="button"
  class={`burger ${className}`}
  {...rest}
  aria-label="Afficher/cacher le menu"
  aria-expanded="false"
>
  <span></span>
  <span></span>
  <span></span>
</button>

<script>
  // Délégation sur le document : les transitions de vue remplacent le bouton à
  // chaque navigation, et un écouteur attaché à l'ancien élément serait perdu
  // sans que rien ne le signale.
  document.addEventListener('click', (evenement) => {
    const cible = evenement.target as HTMLElement | null;
    const burger = cible?.closest<HTMLButtonElement>('.burger');
    if (!burger) return;

    const ouvert = burger.classList.toggle('is-open');
    burger.setAttribute('aria-expanded', String(ouvert));
  });

  // Le menu doit se refermer quand on choisit une destination, sans quoi il
  // reste déployé par-dessus la page d'arrivée.
  document.addEventListener('astro:after-swap', () => {
    document.querySelectorAll('.burger.is-open').forEach((burger) => {
      burger.classList.remove('is-open');
      burger.setAttribute('aria-expanded', 'false');
    });
  });

  // Échap referme le menu : attendu de tout ce qui se superpose au contenu.
  document.addEventListener('keydown', (evenement) => {
    if (evenement.key !== 'Escape') return;
    document.querySelectorAll<HTMLButtonElement>('.burger.is-open').forEach((burger) => {
      burger.classList.remove('is-open');
      burger.setAttribute('aria-expanded', 'false');
      burger.focus();
    });
  });
</script>

<style>
  @layer astro-components {
    .burger {
      position: relative;
      width: 24px;
      height: 24px;
      border: none;
      background: none;
      cursor: pointer;

      span {
        position: absolute;
        left: 0;
        width: 24px;
        height: 2px;
        background: var(--text-color);
        transition: var(--transition-duration);
      }

      span:nth-child(1) {
        top: 4px;
      }

      span:nth-child(2) {
        top: 11px;
      }

      span:nth-child(3) {
        top: 18px;
      }

      &.is-open {
        span:nth-child(1) {
          transform: translateY(7px) rotate(45deg);
        }

        span:nth-child(2) {
          opacity: 0;
        }

        span:nth-child(3) {
          transform: translateY(-7px) rotate(-45deg);
        }
      }
    }
  }
</style>
