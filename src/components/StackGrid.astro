---
import { STACK } from '../data/stack.ts';
import type { Langue } from '../i18n/index.ts';

interface Props {
  langue: Langue;
  class?: string;
}

const { langue, class: className = '' } = Astro.props;
---

<ul class={`stack reveal-stagger ${className}`}>
  {
    STACK.map((groupe) => (
      <li class="stack__groupe">
        <h3 class="stack__titre">{groupe.libelle[langue]}</h3>
        <ul class="tech-list">
          {groupe.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </li>
    ))
  }
</ul>

<style lang="scss">
  .stack {
    list-style-type: none;
    padding-inline-start: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-m) var(--space-s);
  }

  .stack__groupe {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding-top: var(--space-xs);
    border-top: 2px solid var(--primary);
  }

  .stack__titre {
    font-size: var(--text-0);
    font-weight: 600;
    color: var(--heading-color);
  }
</style>
